# ---- AnyConv configuration ----
# Copy to ".env" and adjust. Every value has a sensible default; the app runs
# with zero configuration.

# HTTP port
PORT=3000

# Public base URL of the site (used for Stripe redirect URLs).
PUBLIC_BASE_URL=http://localhost:3000

# Max upload size in megabytes.
MAX_UPLOAD_MB=200

# How long (minutes) a converted file is kept before automatic cleanup.
FILE_TTL_MINUTES=30

# Directory for temporary uploaded/converted files.
WORK_DIR=./tmp-uploads

# Override tool binary locations if they are not on PATH.
# FFMPEG_PATH=/usr/bin/ffmpeg
# SOFFICE_PATH=/usr/bin/soffice
# GS_PATH=/usr/bin/gs
# PANDOC_PATH=/usr/bin/pandoc

# ---- Stripe (optional) ----
# Leave STRIPE_SECRET_KEY empty to run AnyConv in FREE mode (no payment).
# Set it to enable pay-per-conversion.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price charged per converted file, in the smallest currency unit (e.g. cents).
PRICE_AMOUNT=99
PRICE_CURRENCY=usd
